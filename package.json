{
  "name": "clavelocal",
  "version": "0.4.0",
  "private": true,
  "description": "Generador y bóveda de contraseñas local, privada y de código abierto.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "desktop:build": "tauri build -- --locked",
    "desktop:build:signed": "node scripts/build-signed-windows.mjs",
    "desktop:dev": "tauri dev"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JosuaPerez/clavelocal.git"
  },
  "keywords": [
    "password-manager",
    "password-generator",
    "privacy",
    "security",
    "web-crypto",
    "spanish"
  ],
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4"
  }
}
