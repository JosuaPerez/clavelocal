{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaveLocal",
  "version": "0.2.0",
  "identifier": "io.github.josuaperez.clavelocal",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ClaveLocal", "width": 1200, "height": 820, "minWidth": 760, "minHeight": 600 }],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": [], "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish"] } } }
}
