{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaveLocal",
  "version": "0.3.0",
  "identifier": "io.github.josuaperez.clavelocal",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "ClaveLocal", "width": 1200, "height": 820, "minWidth": 760, "minHeight": 600 }],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"], "windows": { "nsis": { "installerIcon": "icons/icon.ico", "installMode": "currentUser", "languages": ["Spanish"] } } },
  "plugins": { "updater": {
    "requireSignedVersion": true,
    "allowDowngrades": false,
    "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGOTlBMzNENTk0OUQ4NUQKUldSZDJFbFpQYU9aSC9jcDVhQU1LSFpQcE1rbVYwTTJYWFBLcGZtWHZpVEg3MTYwUmlheU9mN1AK",
    "endpoints": ["https://josuaperez.github.io/clavelocal/updates/windows.json"],
    "windows": { "installMode": "passive" }
  } }
}
